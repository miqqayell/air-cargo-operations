{
  "realm": "air-freight",
  "displayName": "Air Cargo Operations",
  "loginTheme": "air-freight",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {"name": "flight-planner", "description": "Registers, changes and removes delays; records actual departure and arrival times"},
      {"name": "load-planner", "description": "Positions ULDs, checks the load and declares it final"},
      {"name": "admin", "description": "Reads and changes the policy settings"}
    ]
  },
  "users": [
    {
      "username": "t_flight_planner",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Fiona",
      "lastName": "Flightplanner",
      "email": "flight.planner@air-freight.test",
      "credentials": [{"type": "password", "value": "t_password", "temporary": false}],
      "realmRoles": ["flight-planner"]
    },
    {
      "username": "t_load_planner",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Liam",
      "lastName": "Loadplanner",
      "email": "load.planner@air-freight.test",
      "credentials": [{"type": "password", "value": "t_password", "temporary": false}],
      "realmRoles": ["load-planner"]
    },
    {
      "username": "t_admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "email": "admin@air-freight.test",
      "credentials": [{"type": "password", "value": "t_password", "temporary": false}],
      "realmRoles": ["admin"]
    }
  ],
  "clients": [
    {
      "clientId": "air-freight-frontend",
      "name": "Air freight web interface",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience air-freight-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "air-freight-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "air-freight-api",
      "name": "Air freight API, for the .http file",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience air-freight-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "air-freight-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
